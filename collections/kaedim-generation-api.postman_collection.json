  "info": {
    "_postman_id": "92f23977-c8bf-4490-b1b4-8da304339f39",
    "name": "Kaedim Web Assets Generation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Kaedim Web API lets Enterprise customers integrate Kaedim's AI 2D-to-3D asset generation into internal 3D modelling pipelines and user-facing applications. Submit images (photos, sketches, concept art), poll or receive results via webhook, and download generated models in obj, fbx, glb, gltf, mtl and usd formats. This description is generated by the API Evangelist enrichment pipeline from Kaedim's published Web API documentation; it is not an official Kaedim OpenAPI definition.\n\nContact Support:\n Name: Kaedim Support\n Email: support@kaedim3d.com",
      "type": "text/plain"
    }
  }
